<%- include('../partials/admin-nav') %>

<div class="panel-header flex-header">
  <div>
    <h2><i class="fas fa-utensils"></i> Manage Recipes</h2>
    <p>Add, edit and organize cooking recipes by category</p>
  </div>
  <div style="display: flex; gap: 10px;">
    <a href="/admin/categories" class="btn-secondary"><i class="fas fa-tags"></i> MANAGE CATEGORIES</a>
    <a href="/admin/recipes/add" class="btn-primary"><i class="fas fa-plus"></i> ADD NEW RECIPE</a>
  </div>
</div>

<div class="table-container">
  <% if (recipes.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-folder-open"></i>
      <p>No recipes found. Click the button above to add your first recipe!</p>
    </div>
  <% } else { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Image</th>
          <th>Recipe Title</th>
          <th>Category</th>
          <th>Date Created</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% recipes.forEach(recipe => { %>
          <tr>
            <td class="td-thumb">
              <img src="<%= recipe.images[0] %>" alt="<%= recipe.title %>" class="table-thumb">
            </td>
            <td class="td-title">
              <strong><%= recipe.title %></strong>
              <p class="table-excerpt"><%= recipe.description %></p>
            </td>
            <td><span class="badge badge-info"><%= recipe.category %></span></td>
            <td><%= recipe.date %></td>
            <td class="td-actions">
              <a href="/admin/recipes/edit/<%= recipe.id %>" class="btn-action btn-edit" title="Edit"><i class="fas fa-edit"></i></a>
              <form action="/admin/recipes/delete/<%= recipe.id %>" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this recipe?');">
                <button type="submit" class="btn-action btn-delete" title="Delete"><i class="fas fa-trash-alt"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

</main>
</div>
</body>
</html>
