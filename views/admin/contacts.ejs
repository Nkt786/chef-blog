<%- include('../partials/admin-nav') %>

<div class="panel-header">
  <h2><i class="fas fa-envelope"></i> Contact Enquiries</h2>
  <p>Read and manage incoming questions and consultation requests from the website</p>
</div>

<div class="table-container">
  <% if (enquiries.length === 0) { %>
    <div class="empty-state">
      <i class="far fa-envelope-open"></i>
      <p>No enquiries received yet. Form submissions will appear here!</p>
    </div>
  <% } else { %>
    <div class="enquiries-list">
      <% enquiries.forEach(enq => { %>
        <div class="enquiry-card <%= enq.read ? '' : 'unread-enquiry' %>">
          <div class="enquiry-card-header">
            <div class="enq-sender">
              <h3><%= enq.name %></h3>
              <a href="mailto:<%= enq.email %>" class="enq-email"><i class="far fa-envelope"></i> <%= enq.email %></a>
            </div>
            <div class="enq-meta">
              <span class="enq-date"><%= enq.date %></span>
              <% if (!enq.read) { %>
                <span class="badge badge-warning">New</span>
              <% } else { %>
                <span class="badge badge-secondary">Read</span>
              <% } %>
            </div>
          </div>
          <div class="enquiry-subject">
            <strong>Subject:</strong> <%= enq.subject %>
          </div>
          <div class="enquiry-message">
            <p><%= enq.message %></p>
          </div>
          <div class="enquiry-actions">
            <% if (!enq.read) { %>
              <form action="/admin/contacts/read/<%= enq.id %>" method="POST" class="inline-form">
                <button type="submit" class="btn-read-enq"><i class="fas fa-check"></i> Mark as Read</button>
              </form>
            <% } %>
            <form action="/admin/contacts/delete/<%= enq.id %>" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this enquiry?');">
              <button type="submit" class="btn-delete-enq"><i class="fas fa-trash-alt"></i> Delete</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

</main>
</div>
</body>
</html>
