<%- include('../partials/admin-nav') %>

<div class="panel-header">
  <h2><i class="fas fa-leaf"></i> Manage Sustainability Content</h2>
  <p>Update articles, philosophy declarations, and farm-to-table projects</p>
</div>

<!-- Add Block Section -->
<div class="content-panel">
  <h3>Add New Sustainability Block</h3>
  <div class="panel-divider"></div>
  <form action="/admin/sustainability/add" method="POST" enctype="multipart/form-data" class="admin-form">
    <div class="form-row">
      <div class="form-group col-8">
        <label for="title">Block/Project Title *</label>
        <input type="text" id="title" name="title" required placeholder="e.g. Biodiverse Farming Alliances">
      </div>
      <div class="form-group col-4">
        <label for="image">Featured Image *</label>
        <input type="file" id="image" name="image" accept="image/*" required>
      </div>
    </div>
    <div class="form-group">
      <label for="content">Block Content (HTML allowed) *</label>
      <textarea id="content" name="content" rows="6" required placeholder="<p>Enter project details or philosophy narrative here...</p>"></textarea>
    </div>
    <button type="submit" class="btn-primary"><i class="fas fa-plus"></i> ADD BLOCK</button>
  </form>
</div>

<!-- Existing Blocks List -->
<div class="table-container m-t-30">
  <h3>Existing Sustainability Blocks</h3>
  <div class="panel-divider"></div>

  <% if (blocks.length === 0) { %>
    <div class="empty-state">
      <p>No sustainability blocks found. Add your first content block above!</p>
    </div>
  <% } else { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Image</th>
          <th>Title</th>
          <th>Narrative Excerpt</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% blocks.forEach(block => { %>
          <tr>
            <td class="td-thumb">
              <img src="<%= block.image %>" alt="<%= block.title %>" class="table-thumb">
            </td>
            <td><strong><%= block.title %></strong></td>
            <td class="td-desc"><%- block.content.substring(0, 150) %>...</td>
            <td class="td-actions">
              <!-- Edit Helper Form -->
              <form action="/admin/sustainability/edit/<%= block.id %>" method="POST" class="row-edit-form-sus">
                <input type="hidden" name="title" value="<%= block.title %>">
                <input type="hidden" name="content" value="<%= block.content %>">
              </form>
              <button type="button" class="btn-action btn-edit" onclick="triggerSusEdit(this, '<%= block.id %>')"><i class="fas fa-edit"></i></button>

              <form action="/admin/sustainability/delete/<%= block.id %>" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this block?');">
                <button type="submit" class="btn-action btn-delete"><i class="fas fa-trash-alt"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<!-- Sustainability Edit Modal -->
<div class="admin-modal" id="susEditModal">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Edit Sustainability Block</h3>
      <span class="modal-close" onclick="closeSusModal()">&times;</span>
    </div>
    <form id="susModalEditForm" method="POST" enctype="multipart/form-data" class="admin-form">
      <div class="form-group">
        <label for="susModalTitle">Title</label>
        <input type="text" id="susModalTitle" name="title" required>
      </div>
      <div class="form-group">
        <label for="susModalContent">Content (HTML allowed)</label>
        <textarea id="susModalContent" name="content" rows="6" required></textarea>
      </div>
      <div class="form-group">
        <label for="susModalImage">Change Image (optional)</label>
        <input type="file" id="susModalImage" name="image" accept="image/*">
      </div>
      <div class="form-actions">
        <button type="submit" class="btn-primary">SAVE CHANGES</button>
        <button type="button" class="btn-secondary" onclick="closeSusModal()">CANCEL</button>
      </div>
    </form>
  </div>
</div>

<script>
  function triggerSusEdit(button, id) {
    const row = button.closest('tr');
    const form = row.querySelector('.row-edit-form-sus');
    
    document.getElementById('susModalTitle').value = form.querySelector('[name="title"]').value;
    document.getElementById('susModalContent').value = form.querySelector('[name="content"]').value;
    
    document.getElementById('susModalEditForm').action = '/admin/sustainability/edit/' + id;
    document.getElementById('susEditModal').classList.add('active');
  }

  function closeSusModal() {
    document.getElementById('susEditModal').classList.remove('active');
  }
</script>

</main>
</div>
</body>
</html>
