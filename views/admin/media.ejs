<%- include('../partials/admin-nav') %>

<div class="panel-header">
  <h2><i class="fas fa-images"></i> Media & Uploads Gallery</h2>
  <p>Upload food pictures and copy image URLs for embedding into your blogs or recipes</p>
</div>

<!-- Upload Form -->
<div class="content-panel">
  <h3>Upload New Image</h3>
  <div class="panel-divider"></div>
  <form action="/admin/media/upload" method="POST" enctype="multipart/form-data" class="admin-form flex-upload-form">
    <div class="form-group flex-1">
      <input type="file" name="mediafile" accept="image/*" required class="file-input-btn">
    </div>
    <button type="submit" class="btn-primary"><i class="fas fa-upload"></i> UPLOAD</button>
  </form>
</div>

<!-- Media Gallery Grid -->
<div class="gallery-container m-t-30">
  <h3>Uploaded Image Library</h3>
  <div class="panel-divider"></div>
  
  <% if (images.length === 0) { %>
    <div class="empty-state">
      <i class="far fa-images"></i>
      <p>No uploaded pictures found in the uploads directory yet.</p>
    </div>
  <% } else { %>
    <div class="media-grid">
      <% images.forEach(img => { %>
        <div class="media-card">
          <div class="media-img-wrapper">
            <img src="<%= img %>" alt="Uploaded media item">
          </div>
          <div class="media-details">
            <input type="text" readonly value="<%= img %>" class="media-url-input" onclick="this.select()">
            <div class="media-actions-row">
              <button class="btn-copy-url" onclick="copyToClipboard('<%= img %>', this)">
                <i class="far fa-copy"></i> Copy Link
              </button>
              <form action="/admin/media/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this media image file?');">
                <input type="hidden" name="imagePath" value="<%= img %>">
                <button type="submit" class="btn-delete-media"><i class="far fa-trash-alt"></i> Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<script>
  function copyToClipboard(text, button) {
    navigator.clipboard.writeText(text).then(() => {
      const originalText = button.innerHTML;
      button.innerHTML = '<i class="fas fa-check"></i> Copied!';
      button.classList.add('btn-copied');
      setTimeout(() => {
        button.innerHTML = originalText;
        button.classList.remove('btn-copied');
      }, 2000);
    });
  }
</script>

</main>
</div>
</body>
</html>
