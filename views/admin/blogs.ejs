<%- include('../partials/admin-nav') %>

<div class="panel-header flex-header">
  <div>
    <h2><i class="fas fa-newspaper"></i> Manage Blog Portfolio</h2>
    <p>Create, edit and publish your food stories and blog updates</p>
  </div>
  <a href="/admin/blogs/add" class="btn-primary"><i class="fas fa-plus"></i> ADD NEW BLOG</a>
</div>

<div class="table-container">
  <% if (blogs.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-folder-open"></i>
      <p>No blog posts found. Click the button above to publish your first post!</p>
    </div>
  <% } else { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Featured Image</th>
          <th>Title</th>
          <th>Year</th>
          <th>Date</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% blogs.forEach(blog => { %>
          <tr>
            <td class="td-thumb">
              <img src="<%= blog.image %>" alt="<%= blog.title %>" class="table-thumb">
            </td>
            <td class="td-title">
              <strong><%= blog.title %></strong>
              <p class="table-excerpt"><%= blog.excerpt %></p>
            </td>
            <td><%= blog.year %></td>
            <td><%= blog.date %></td>
            <td>
              <% if (blog.published) { %>
                <span class="badge badge-success">Published</span>
              <% } else { %>
                <span class="badge badge-warning">Draft</span>
              <% } %>
            </td>
            <td class="td-actions">
              <a href="/admin/blogs/edit/<%= blog.id %>" class="btn-action btn-edit" title="Edit"><i class="fas fa-edit"></i></a>
              <form action="/admin/blogs/delete/<%= blog.id %>" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this blog post?');">
                <button type="submit" class="btn-action btn-delete" title="Delete"><i class="fas fa-trash-alt"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

</main>
</div>
</body>
</html>
