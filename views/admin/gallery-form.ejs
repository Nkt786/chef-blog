<%- include('../partials/admin-nav') %>

<div class="panel-header" style="margin-bottom: 25px;">
  <h2><i class="fas fa-camera-retro"></i> <%= item ? 'Edit Food Photo' : 'Add New Food Photo' %></h2>
  <p><%= item ? 'Update food dish details and image' : 'Upload a food picture with dish name, category, and optional description' %></p>
</div>

<div class="admin-card">
  <form action="<%= item ? '/admin/gallery/edit/' + item.id : '/admin/gallery/add' %>" method="POST" enctype="multipart/form-data" class="admin-form">
    
    <div class="form-row">
      <div class="form-group col-8">
        <label for="title">Food Dish Name <span style="color: var(--admin-red);">*</span></label>
        <input type="text" id="title" name="title" value="<%= item ? item.title : '' %>" placeholder="e.g. Pan-Seared Wild Sea Bass" required>
      </div>

      <div class="form-group col-4">
        <label for="category">Category</label>
        <div style="display: flex; gap: 8px;">
          <select id="category" name="category" style="flex-grow: 1;">
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= (item && item.category === cat) ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>
      </div>
    </div>

    <!-- Image Upload with Cropper Tool -->
    <div class="form-row">
      <div class="form-group col-8">
        <label for="galleryImage">Upload Food Picture</label>
        <input type="file" id="galleryImage" name="image" accept="image/*" class="crop-input" data-aspect="1.3333" data-preview="#galleryPreviewImg">
        <small class="form-help">
          <i class="fas fa-magic"></i> Selecting an image automatically opens the <strong>Crop & Edit tool</strong> so you can frame the food picture perfectly (4:3 or Free crop).
        </small>

        <div style="margin-top: 15px;">
          <label for="imageUrl" style="font-size: 12px; color: var(--admin-text-secondary);">Or paste an Image Web URL (optional):</label>
          <input type="text" id="imageUrl" name="imageUrl" value="<%= (item && item.image && !item.image.startsWith('/uploads/')) ? item.image : '' %>" placeholder="https://example.com/food-dish.jpg">
        </div>
      </div>

      <div class="form-group col-4">
        <label>Photo Preview</label>
        <div style="margin-top: 5px; text-align: center; background: #fafafa; border: 1px dashed var(--admin-border-color); border-radius: 8px; padding: 10px; min-height: 160px; display: flex; align-items: center; justify-content: center;">
          <img id="galleryPreviewImg" src="<%= item ? item.image : '/images/default-food.jpg' %>" alt="Preview" onerror="this.onerror=null;this.src='/images/default-food.jpg';" style="max-width: 100%; max-height: 140px; border-radius: 6px; object-fit: cover; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        </div>
      </div>
    </div>

    <div class="form-group">
      <label for="description">Dish Description / Caption (Optional)</label>
      <textarea id="description" name="description" rows="4" placeholder="Briefly describe the ingredients, culinary preparation, or plating notes..."><%= item ? item.description : '' %></textarea>
    </div>

    <div style="margin-top: 30px; display: flex; gap: 15px;">
      <button type="submit" class="btn-primary"><i class="fas fa-save"></i> <%= item ? 'UPDATE DISH PHOTO' : 'SAVE TO GALLERY' %></button>
      <a href="/admin/gallery" class="btn-secondary" style="background: #f0f0f0; color: #595959; text-decoration: none; padding: 10px 20px; border-radius: 4px; display: inline-flex; align-items: center;">Cancel</a>
    </div>

  </form>
</div>

</main>
</div>
</body>
</html>
