<%- include('../partials/admin-nav') %>

<!-- Statistics Cards Grid -->
<div class="stats-grid">
  
  <div class="stat-card">
    <div class="stat-icon icon-blue"><i class="fas fa-newspaper"></i></div>
    <div class="stat-info">
      <h3>Blogs</h3>
      <p class="stat-number"><%= blogCount %></p>
      <a href="/admin/blogs" class="stat-link">Manage Blogs <i class="fas fa-arrow-right"></i></a>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon icon-green"><i class="fas fa-camera-retro"></i></div>
    <div class="stat-info">
      <h3>Gallery Dishes</h3>
      <p class="stat-number"><%= typeof galleryCount !== 'undefined' ? galleryCount : 0 %></p>
      <a href="/admin/gallery" class="stat-link">Manage Gallery <i class="fas fa-arrow-right"></i></a>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon icon-orange"><i class="fas fa-envelope"></i></div>
    <div class="stat-info">
      <h3>New Enquiries</h3>
      <p class="stat-number"><%= unreadEnquiries %></p>
      <a href="/admin/contacts" class="stat-link">View Contacts <i class="fas fa-arrow-right"></i></a>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon icon-purple"><i class="fas fa-users"></i></div>
    <div class="stat-info">
      <h3>Subscribers</h3>
      <p class="stat-number"><%= subscriberCount %></p>
      <a href="/admin/newsletter" class="stat-link">View Subscribers <i class="fas fa-arrow-right"></i></a>
    </div>
  </div>

</div>

<!-- Homepage Photos & Showcase Callout Card -->
<div class="homepage-promo-banner" style="background: linear-gradient(135deg, #1b2838 0%, #243342 100%); color: #fff; padding: 22px 28px; border-radius: 8px; margin-bottom: 25px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.06); border-left: 5px solid #27ae60;">
  <div style="display: flex; align-items: center; gap: 18px;">
    <div style="width: 48px; height: 48px; border-radius: 8px; background: rgba(39, 174, 96, 0.15); display: flex; align-items: center; justify-content: center; font-size: 22px; color: #2ecc71;">
      <i class="fas fa-camera"></i>
    </div>
    <div>
      <h3 style="margin: 0 0 4px; font-size: 16px; color: #fff; font-weight: 600;">Edit Homepage Photos & Banners</h3>
      <p style="margin: 0; font-size: 13px; color: #cbd5e1;">Customize the 3 Hero slideshow photos, the 3 Featured Showcase photos, and homepage stories with your original pictures.</p>
    </div>
  </div>
  <a href="/admin/homepage" class="btn-primary" style="background: #27ae60; color: #fff; text-decoration: none; padding: 11px 22px; border-radius: 6px; font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; border: none; box-shadow: 0 2px 8px rgba(39, 174, 96, 0.3);">
    <i class="fas fa-edit"></i> EDIT HOMEPAGE PHOTOS
  </a>
</div>

<!-- Settings Panel -->
<div class="settings-panel">
  <div class="panel-header">
    <h2><i class="fas fa-cog"></i> Website Settings</h2>
    <p>Update site content details and security configuration</p>
  </div>
  <div class="panel-body">
    <form action="/admin/settings" method="POST" enctype="multipart/form-data" class="admin-form">
      <div class="form-row">
        <div class="form-group col-6">
          <label for="brandName">Chef Brand Name</label>
          <input type="text" id="brandName" name="brandName" value="<%= settings.brandName %>" required>
        </div>
        <div class="form-group col-6">
          <label for="tagline">Main Concept/Tagline</label>
          <input type="text" id="tagline" name="tagline" value="<%= settings.tagline %>" required>
        </div>
      </div>

      <div class="form-group">
        <label for="shortDescription">Website Short Description</label>
        <input type="text" id="shortDescription" name="shortDescription" value="<%= settings.shortDescription %>" required>
      </div>

      <div class="form-row">
        <div class="form-group col-6">
          <label for="chefImage">Chef Profile Image (Portrait)</label>
          <input type="file" id="chefImage" name="chefImage" accept="image/*" class="crop-input" data-aspect="0.75" data-preview="#chefPreviewImg">
          <small class="form-help">Upload portrait photo of the chef (3:4 aspect ratio recommended).</small>
        </div>
        <div class="form-group col-6">
          <label>Current Profile Image</label>
          <div style="margin-top: 5px;">
            <img id="chefPreviewImg" src="<%= settings.chefImage || '/images/chef-portrait.jpg' %>" alt="Chef Portrait Preview" onerror="this.onerror=null;this.src='/images/chef-portrait.jpg';" style="height: 85px; width: 68px; border-radius: 6px; border: 1px solid var(--admin-border-color); object-fit: cover; object-position: top center;">
          </div>
        </div>
      </div>

      <!-- Homepage Photos Quick Link Card -->
      <div style="background: #f8fafc; border: 1px solid var(--admin-border-color); border-radius: 8px; padding: 16px 20px; margin: 25px 0 15px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; border-left: 4px solid #27ae60;">
        <div>
          <strong style="color: var(--admin-text-main); font-size: 14px; display: flex; align-items: center; gap: 8px;">
            <i class="fas fa-camera" style="color: #27ae60;"></i> Homepage Photos (3 Hero Slides & 3 Showcase Photos)
          </strong>
          <span style="font-size: 12px; color: var(--admin-text-secondary); display: block; margin-top: 3px;">
            Easily upload and crop the client's original food photos, showcase dishes, and hero banners.
          </span>
        </div>
        <a href="/admin/homepage" class="btn-secondary" style="background: #27ae60; color: #fff; padding: 8px 16px; border-radius: 5px; font-size: 12px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
          <i class="fas fa-edit"></i> Edit Homepage Photos
        </a>
      </div>

      <h3 style="margin: 25px 0 10px; font-size: 14px; border-bottom: 1px solid var(--admin-border-color); padding-bottom: 5px; color: var(--admin-text-main);">Page Headings & Subtitles</h3>

      <div class="form-row">
        <div class="form-group col-6">
          <label for="gallerySubtitle">Gallery Page Subtitle</label>
          <input type="text" id="gallerySubtitle" name="gallerySubtitle" value="<%= settings.gallerySubtitle || settings.recipeSubtitle || 'Signature Creations by Chef Nitesh' %>">
        </div>
        <div class="form-group col-6">
          <label for="galleryHeading">Gallery Page Heading</label>
          <input type="text" id="galleryHeading" name="galleryHeading" value="<%= settings.galleryHeading || settings.recipeHeading || 'Culinary Gallery' %>">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group col-6">
          <label for="blogSubtitle">Blog Page Subtitle</label>
          <input type="text" id="blogSubtitle" name="blogSubtitle" value="<%= settings.blogSubtitle || 'Aroma of Life Stories' %>">
        </div>
        <div class="form-group col-6">
          <label for="blogHeading">Blog Page Heading</label>
          <input type="text" id="blogHeading" name="blogHeading" value="<%= settings.blogHeading || 'Chef Blog Portfolio' %>">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group col-6">
          <label for="journeySubtitle">Journey Page Subtitle</label>
          <input type="text" id="journeySubtitle" name="journeySubtitle" value="<%= settings.journeySubtitle || 'My Work So Far' %>">
        </div>
        <div class="form-group col-6">
          <label for="journeyHeading">Journey Page Heading</label>
          <input type="text" id="journeyHeading" name="journeyHeading" value="<%= settings.journeyHeading || 'Chef\'s Professional Journey' %>">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group col-6">
          <label for="sustainabilitySubtitle">Sustainability Subtitle</label>
          <input type="text" id="sustainabilitySubtitle" name="sustainabilitySubtitle" value="<%= settings.sustainabilitySubtitle || 'Eco-conscious Gastronomy' %>">
        </div>
        <div class="form-group col-6">
          <label for="sustainabilityHeading">Sustainability Heading</label>
          <input type="text" id="sustainabilityHeading" name="sustainabilityHeading" value="<%= settings.sustainabilityHeading || 'Sustainability Philosophy' %>">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group col-6">
          <label for="aboutSubtitle">About Me Subtitle</label>
          <input type="text" id="aboutSubtitle" name="aboutSubtitle" value="<%= settings.aboutSubtitle || 'The Culinary Story' %>">
        </div>
        <div class="form-group col-6">
          <label for="aboutHeading">About Me Heading</label>
          <input type="text" id="aboutHeading" name="aboutHeading" value="<%= settings.aboutHeading || 'About Chef Nitesh' %>">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group col-6">
          <label for="contactSubtitle">Contact Page Subtitle</label>
          <input type="text" id="contactSubtitle" name="contactSubtitle" value="<%= settings.contactSubtitle || 'Get In Touch' %>">
        </div>
        <div class="form-group col-6">
          <label for="contactHeading">Contact Page Heading</label>
          <input type="text" id="contactHeading" name="contactHeading" value="<%= settings.contactHeading || 'Contact Chef Nitesh' %>">
        </div>
      </div>

      <!-- About Me Settings -->
      <h3 style="margin: 25px 0 10px; font-size: 14px; border-bottom: 1px solid var(--admin-border-color); padding-bottom: 5px; color: var(--admin-text-main);">About Me Details</h3>
      
      <div class="form-row">
        <div class="form-group col-6">
          <label for="aboutTitleTag">About Page Title Tag</label>
          <input type="text" id="aboutTitleTag" name="aboutTitleTag" value="<%= settings.aboutTitleTag || 'Classically Trained | over 15 Years Experience' %>">
        </div>
        <div class="form-group col-6">
          <label for="aboutQuote">About Page Quote</label>
          <input type="text" id="aboutQuote" name="aboutQuote" value="<%= settings.aboutQuote || '"Cooking is an art form driven by passion and executed with precision."' %>">
        </div>
      </div>

      <div class="form-group">
        <label for="aboutHighlightText">About Page Highlighted Bio Text</label>
        <textarea id="aboutHighlightText" name="aboutHighlightText" rows="3"><%= settings.aboutHighlightText || '' %></textarea>
      </div>

      <div class="form-row">
        <div class="form-group col-6">
          <label for="aboutBioParagraph1">Bio Paragraph 1</label>
          <textarea id="aboutBioParagraph1" name="aboutBioParagraph1" rows="5"><%= settings.aboutBioParagraph1 || '' %></textarea>
        </div>
        <div class="form-group col-6">
          <label for="aboutBioParagraph2">Bio Paragraph 2</label>
          <textarea id="aboutBioParagraph2" name="aboutBioParagraph2" rows="5"><%= settings.aboutBioParagraph2 || '' %></textarea>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group col-6">
          <label for="aboutSignatureName">Signature Name</label>
          <input type="text" id="aboutSignatureName" name="aboutSignatureName" value="<%= settings.aboutSignatureName || 'Nitesh Sharma' %>">
        </div>
        <div class="form-group col-6">
          <label for="aboutSignatureTitle">Signature Title</label>
          <input type="text" id="aboutSignatureTitle" name="aboutSignatureTitle" value="<%= settings.aboutSignatureTitle || 'Executive Chef & Culinary Consultant' %>">
        </div>
      </div>

      <h4 style="margin: 20px 0 5px; font-size: 13px; font-weight: 600; color: var(--admin-text-main);">Core Specialties (4 cards on About page)</h4>
      <div class="form-row">
        <div class="form-group col-6">
          <label for="aboutSpecialty1Title">Specialty 1 Title</label>
          <input type="text" id="aboutSpecialty1Title" name="aboutSpecialty1Title" value="<%= settings.aboutSpecialty1Title || 'Seasonal Mediterranean Menus' %>">
          <label for="aboutSpecialty1Desc" style="margin-top: 5px; font-size: 11px;">Specialty 1 Description</label>
          <textarea id="aboutSpecialty1Desc" name="aboutSpecialty1Desc" rows="2"><%= settings.aboutSpecialty1Desc || '' %></textarea>
        </div>
        <div class="form-group col-6">
          <label for="aboutSpecialty2Title">Specialty 2 Title</label>
          <input type="text" id="aboutSpecialty2Title" name="aboutSpecialty2Title" value="<%= settings.aboutSpecialty2Title || 'Contemporary Cooking Methods' %>">
          <label for="aboutSpecialty2Desc" style="margin-top: 5px; font-size: 11px;">Specialty 2 Description</label>
          <textarea id="aboutSpecialty2Desc" name="aboutSpecialty2Desc" rows="2"><%= settings.aboutSpecialty2Desc || '' %></textarea>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group col-6">
          <label for="aboutSpecialty3Title">Specialty 3 Title</label>
          <input type="text" id="aboutSpecialty3Title" name="aboutSpecialty3Title" value="<%= settings.aboutSpecialty3Title || 'Zero-Waste Kitchen Design' %>">
          <label for="aboutSpecialty3Desc" style="margin-top: 5px; font-size: 11px;">Specialty 3 Description</label>
          <textarea id="aboutSpecialty3Desc" name="aboutSpecialty3Desc" rows="2"><%= settings.aboutSpecialty3Desc || '' %></textarea>
        </div>
        <div class="form-group col-6">
          <label for="aboutSpecialty4Title">Specialty 4 Title</label>
          <input type="text" id="aboutSpecialty4Title" name="aboutSpecialty4Title" value="<%= settings.aboutSpecialty4Title || 'Kitchen Team Leadership' %>">
          <label for="aboutSpecialty4Desc" style="margin-top: 5px; font-size: 11px;">Specialty 4 Description</label>
          <textarea id="aboutSpecialty4Desc" name="aboutSpecialty4Desc" rows="2"><%= settings.aboutSpecialty4Desc || '' %></textarea>
        </div>
      </div>

      <!-- Contact Details Settings -->
      <h3 style="margin: 25px 0 10px; font-size: 14px; border-bottom: 1px solid var(--admin-border-color); padding-bottom: 5px; color: var(--admin-text-main);">Contact Me Details</h3>
      
      <div class="form-row">
        <div class="form-group col-3">
          <label for="contactPhone">Phone Number</label>
          <input type="text" id="contactPhone" name="contactPhone" value="<%= settings.contactPhone || '+91-9521342251' %>">
        </div>
        <div class="form-group col-3">
          <label for="contactWhatsapp">WhatsApp Number</label>
          <input type="text" id="contactWhatsapp" name="contactWhatsapp" value="<%= settings.contactWhatsapp || '+91-9521342251' %>">
        </div>
        <div class="form-group col-3">
          <label for="contactEmail">Contact Email</label>
          <input type="email" id="contactEmail" name="contactEmail" value="<%= settings.contactEmail || 'Niteshind84@yahoo.com' %>">
        </div>
        <div class="form-group col-3">
          <label for="contactLinkedin">LinkedIn Username</label>
          <input type="text" id="contactLinkedin" name="contactLinkedin" value="<%= settings.contactLinkedin || 'chefnitesh' %>">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group col-6">
          <label for="contactIntroTitle">Contact Intro Title</label>
          <input type="text" id="contactIntroTitle" name="contactIntroTitle" value="<%= settings.contactIntroTitle || "Let's Craft Something Together" %>">
        </div>
        <div class="form-group col-6">
          <label for="contactIntroText">Contact Intro Description</label>
          <textarea id="contactIntroText" name="contactIntroText" rows="2"><%= settings.contactIntroText || '' %></textarea>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group col-6">
          <label for="contactNewsletterTitle">Newsletter Widget Title</label>
          <input type="text" id="contactNewsletterTitle" name="contactNewsletterTitle" value="<%= settings.contactNewsletterTitle || 'Subscribe to Chef Newsletter' %>">
        </div>
        <div class="form-group col-6">
          <label for="contactNewsletterText">Newsletter Widget Description</label>
          <textarea id="contactNewsletterText" name="contactNewsletterText" rows="2"><%= settings.contactNewsletterText || '' %></textarea>
        </div>
      </div>

      <h3 style="margin: 25px 0 10px; font-size: 14px; border-bottom: 1px solid var(--admin-border-color); padding-bottom: 5px; color: var(--admin-text-main);">Security Configuration</h3>

      <div class="form-row">
        <div class="form-group col-6">
          <label for="adminPassword">Update Password (leave blank to keep current)</label>
          <input type="password" id="adminPassword" name="adminPassword" placeholder="••••••••">
        </div>
      </div>

      <button type="submit" class="btn-primary">SAVE SETTINGS</button>
    </form>
  </div>
</div>

</main>
</div>
</body>
</html>
