<%- include('../partials/admin-nav') %>

<div class="panel-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
  <div>
    <h2><i class="fas fa-camera-retro"></i> Manage Food Gallery</h2>
    <p>Upload and showcase high-resolution food dishes with dish names and categories &bull; <strong><%= gallery ? gallery.length : 0 %> Total Dishes</strong></p>
  </div>
  <div style="display: flex; gap: 10px;">
    <a href="/gallery" target="_blank" class="btn-secondary"><i class="fas fa-external-link-alt"></i> View Website Gallery</a>
    <a href="/admin/gallery/add" class="btn-primary"><i class="fas fa-plus"></i> Add New Food Photo</a>
  </div>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="login-error" style="margin-bottom: 20px; background: #fff1f0; border: 1px solid #ffa39e; color: #cf1322; padding: 12px 18px; border-radius: 6px; display: flex; align-items: center; gap: 10px; font-size: 14px;">
    <i class="fas fa-exclamation-circle" style="font-size: 18px;"></i>
    <span><%= error %></span>
  </div>
<% } %>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="login-success" style="margin-bottom: 20px; background: #f6ffed; border: 1px solid #b7eb8f; color: #389e0d; padding: 12px 18px; border-radius: 6px; display: flex; align-items: center; gap: 10px; font-size: 14px;">
    <i class="fas fa-check-circle" style="font-size: 18px;"></i>
    <span><%= success %></span>
  </div>
<% } %>

<div class="table-container content-panel">
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th style="width: 100px;">Photo</th>
          <th>Dish Name</th>
          <th>Category</th>
          <th>Description</th>
          <th>Date Added</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!gallery || gallery.length === 0) { %>
          <tr>
            <td colspan="6" style="text-align: center; padding: 40px; color: var(--admin-text-secondary);">
              <i class="fas fa-image" style="font-size: 32px; margin-bottom: 10px; display: block; opacity: 0.5;"></i>
              No food photos in gallery yet. <a href="/admin/gallery/add" style="color: var(--admin-blue);">Add your first dish photo!</a>
            </td>
          </tr>
        <% } else { %>
          <% gallery.forEach(item => { %>
            <tr>
              <td>
                <img src="<%= item.image %>" alt="<%= item.title %>" onerror="this.onerror=null;this.src='/images/default-food.jpg';" style="width: 80px; height: 60px; object-fit: cover; border-radius: 6px; border: 1px solid var(--admin-border-color);">
              </td>
              <td>
                <strong style="font-size: 15px; color: var(--admin-text-main);"><%= item.title %></strong>
              </td>
              <td>
                <span class="badge" style="background: #e6f7ff; color: #1890ff; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 500;">
                  <%= item.category || 'Specialty' %>
                </span>
              </td>
              <td style="max-width: 250px; color: var(--admin-text-secondary); font-size: 13px;">
                <%= item.description ? (item.description.length > 70 ? item.description.substring(0, 70) + '...' : item.description) : '-' %>
              </td>
              <td style="color: var(--admin-text-secondary); font-size: 13px;">
                <%= item.date ? new Date(item.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '-' %>
              </td>
              <td style="text-align: right;">
                <div style="display: inline-flex; gap: 8px;">
                  <a href="/admin/gallery/edit/<%= item.id %>" class="btn-action btn-edit" title="Edit Dish"><i class="fas fa-edit"></i></a>
                  <form action="/admin/gallery/delete/<%= item.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this food picture?');">
                    <button type="submit" class="btn-action btn-delete" title="Delete Dish"><i class="fas fa-trash"></i></button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

</main>
</div>
</body>
</html>
